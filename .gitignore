# Rust build artifacts (3.3 GB): regenerated by `reproduce.sh build`
zkvm/target/

# Prebuilt binaries (~186 MB): regenerated by `reproduce.sh build`
bin/

# Tooling / local state
.claude-flow/
.claude/

# Scratch
/tmp/
# (benchmarks/raw/*.log are kept: they are measurement evidence)

# OS cruft
.DS_Store
Thumbs.db

# LaTeX intermediates (regenerated by `make`; the PDFs are kept)
*.aux
*.log
*.blg
*.bbl
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.run.xml
*.synctex.gz
comment.cut

# ...but the measurement logs are evidence, not build output: keep them
!benchmarks/raw/*.log
!benchmarks/*.log

# Firefox demo profile created by launch.sh (runtime state, not source)
.gps-ff-profile/

# Old history from the private repo, kept locally only. NEVER commit this: it
# contains the verbatim bank-site copies that were removed before publication.
.git-OLD-history-backup/
